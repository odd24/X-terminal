{
  "tools": [
    {
      "name": "agent_status",
      "description": "Native pairing status. No token; approval snapshot is not current permission.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "title": "ListArgs",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "sessions_list",
      "description": "List only sessions visible to this Agent. No implicit current tab.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "title": "ListArgs",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "terminal_read",
      "description": "Read approved retained output. Use view info first, then text with its fixed through_cursor, cursor>=1, max_bytes 4096..65536. Window grants need their approved time window. Protected grants always use protected output.",
      "inputSchema": {
        "$defs": {
          "ConnectionId": {
            "format": "uuid",
            "type": "string"
          },
          "ConnectionRef": {
            "additionalProperties": false,
            "properties": {
              "connection_id": {
                "$ref": "#/$defs/ConnectionId"
              },
              "generation": {
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "connection_id",
              "generation"
            ],
            "type": "object"
          },
          "TimeWindow": {
            "additionalProperties": false,
            "properties": {
              "from_ms": {
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "until_ms": {
                "description": "Exclusive Unix millisecond bound; separate from monotonic grant expiry.",
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "from_ms",
              "until_ms"
            ],
            "type": "object"
          },
          "View": {
            "oneOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "info",
                    "type": "string"
                  }
                },
                "required": [
                  "kind"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "cursor": {
                    "format": "uint64",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "kind": {
                    "const": "text",
                    "type": "string"
                  },
                  "max_bytes": {
                    "format": "uint",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "through_cursor": {
                    "format": "uint64",
                    "minimum": 0,
                    "type": "integer"
                  }
                },
                "required": [
                  "kind",
                  "through_cursor",
                  "cursor",
                  "max_bytes"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "screen",
                    "type": "string"
                  },
                  "through_cursor": {
                    "format": "uint64",
                    "minimum": 0,
                    "type": "integer"
                  }
                },
                "required": [
                  "kind",
                  "through_cursor"
                ],
                "type": "object"
              }
            ]
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "connection": {
            "$ref": "#/$defs/ConnectionRef"
          },
          "view": {
            "$ref": "#/$defs/View"
          },
          "window": {
            "anyOf": [
              {
                "$ref": "#/$defs/TimeWindow"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "connection",
          "view"
        ],
        "title": "OutputArgs",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "terminal_screen",
      "description": "Reconstruct an approved screen at the fixed output watermark. Not a promise of complete VT compatibility.",
      "inputSchema": {
        "$defs": {
          "ConnectionId": {
            "format": "uuid",
            "type": "string"
          },
          "ConnectionRef": {
            "additionalProperties": false,
            "properties": {
              "connection_id": {
                "$ref": "#/$defs/ConnectionId"
              },
