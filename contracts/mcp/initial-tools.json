                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "connection_id",
              "generation"
            ],
            "type": "object"
          },
          "TimeWindow": {
            "additionalProperties": false,
            "properties": {
              "from_ms": {
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "until_ms": {
                "description": "Exclusive Unix millisecond bound; separate from monotonic grant expiry.",
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "from_ms",
              "until_ms"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "connection": {
            "$ref": "#/$defs/ConnectionRef"
          },
          "through_cursor": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "window": {
            "anyOf": [
              {
                "$ref": "#/$defs/TimeWindow"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "connection",
          "through_cursor"
        ],
        "title": "ScreenArgs",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "terminal_send",
      "description": "Send exact text to the explicit SSH2/SERIAL connection, no implicit newline (max 16KiB UTF-8). Requires independent Write and an existing input lease. Keep the original request_id after uncertain delivery.",
      "inputSchema": {
        "$defs": {
          "ConnectionId": {
            "format": "uuid",
            "type": "string"
          },
          "ConnectionRef": {
            "additionalProperties": false,
            "properties": {
              "connection_id": {
                "$ref": "#/$defs/ConnectionId"
              },
              "generation": {
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "connection_id",
              "generation"
            ],
            "type": "object"
          },
          "Sensitive": {
            "type": "string"
          },
          "Transport": {
            "enum": [
              "SSH2",
              "SERIAL"
            ],
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "connection": {
            "$ref": "#/$defs/ConnectionRef"
          },
          "request_id": {
            "format": "uuid",
            "type": "string"
          },
          "text": {
            "$ref": "#/$defs/Sensitive"
          },
          "transport": {
            "$ref": "#/$defs/Transport"
          }
        },
        "required": [
          "transport",
          "connection",
          "request_id",
          "text"
        ],
        "title": "SendArgs",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": true
      }
    },
