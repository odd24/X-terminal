{
  "version": 4,
  "tools": [
    {
      "name": "sessions_disconnect",
      "description": "Request cancellation of an existing SSH2 or SERIAL connection by exact generation and caller-fixed request_id. Requires independent Disconnect approval and input lease. REQUESTED means cancellation was dispatched; TRANSPORT_ENDED means the service observed local transport cleanup. On unknown delivery query sessions_disconnect_status with the original ticket and arguments.",
      "inputSchema": {
        "$defs": {
          "ConnectionId": {
            "format": "uuid",
            "type": "string"
          },
          "ConnectionRef": {
            "additionalProperties": false,
            "properties": {
              "connection_id": {
                "$ref": "#/$defs/ConnectionId"
              },
              "generation": {
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "connection_id",
              "generation"
            ],
            "type": "object"
          },
          "Transport": {
            "enum": [
              "SSH2",
              "SERIAL"
            ],
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "connection": {
            "$ref": "#/$defs/ConnectionRef"
          },
          "request_id": {
            "format": "uuid",
            "type": "string"
          },
          "transport": {
            "$ref": "#/$defs/Transport"
          }
        },
        "required": [
          "transport",
          "connection",
          "request_id"
        ],
        "title": "StatusArgs",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": true
      }
    },
    {
