{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shared Terminal",
  "version": "0.1.30",
  "identifier": "local.shared-terminal.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "共享终端 · 开发预览", "width": 1100, "height": 760, "minWidth": 720, "minHeight": 480, "decorations": false }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": false }
}
